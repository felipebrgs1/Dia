{
  "name": "dia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.tsx",
    "dev": "bun --watch src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "package": "nodebuilder package src/main.tsx --title \"Dia\" --app-id dev.nodebuilder.dia",
    "screenshot": "nodebuilder screenshot src/main.tsx screenshot.png",
    "doctor": "nodebuilder doctor",
    "icons:add": "nodebuilder icons add --out src/icons.ts"
  },
  "dependencies": {
    "@nodebuilderjs/core": "^0.4.0",
    "ical.js": "^2.2.1",
    "lucide-static": "^1.57.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2"
  }
}
